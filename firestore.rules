rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fixed one-user test allowlist; deploy these rules in Firebase Console.
    // All other users or unauthenticated requests are denied.
    function authorized(uid) {
      return request.auth != null &&
        request.auth.uid == uid &&
        request.auth.uid == "rcQFXYxMeDRAUFOfKscAd4H2LWf1";
    }
    function knownTable(table) {
      return table in ['students','entries','tasks','legacy_records'];
    }
    function validRecord(uid,documentId) {
      return request.resource.data.id == documentId &&
        request.resource.data.owner_id == uid &&
        request.resource.data.school_code in ['p31','m34'] &&
        request.resource.data.revision is int;
    }
    match /users/{uid}/{table}/{documentId} {
      allow get, list: if authorized(uid) && knownTable(table);
      allow create: if authorized(uid) && knownTable(table) &&
        validRecord(uid,documentId) &&
        request.resource.data.revision == 1;
      allow update: if authorized(uid) && knownTable(table) &&
        validRecord(uid,documentId) &&
        resource.data.owner_id == uid &&
        request.resource.data.school_code == resource.data.school_code &&
        request.resource.data.revision == resource.data.revision + 1;
      // Owner-only deletion of the exact selected document; never open writes.
      // Cascading related documents is validated by the app's server transaction.
      allow delete: if authorized(uid) && knownTable(table) &&
        resource.data.id == documentId &&
        resource.data.owner_id == uid &&
        resource.data.school_code in ['p31','m34'];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
